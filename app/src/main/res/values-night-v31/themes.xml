<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Use a dark system launch splash when Android is in night mode. -->
    <style
        name="Theme.NagpurPulse"
        parent="Theme.SplashScreen">

        <item name="windowSplashScreenBackground">@color/background_dark</item>

        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_loading_icon</item>

        <item name="postSplashScreenTheme">@style/Theme.NagpurPulse.Dark</item>

    </style>

</resources>
